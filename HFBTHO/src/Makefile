
SHELL := /bin/bash

ifeq ($(COMPILER),GFORTRAN)
      THREAD_LIBRARY = -lgomp
else
      THREAD_LIBRARY =
endif

# Object files
HFBTHO_VERSION_OBJ            = hfbtho_version.o
HFBTHO_UTILITIES_OBJ          = hfbtho_utilities.o
HFBTHO_ELLIPTIC_INTEGRALS_OBJ = hfbtho_elliptic_integrals.o
HFBTHO_BESSEL_OBJ             = hfbtho_bessel.o
HFBTHO_UNEDF_OBJ              = hfbtho_unedf.o
HFBTHO_VARIABLES_OBJ          = hfbtho_variables.o
HFBTHO_MATH_OBJ               = hfbtho_math.o
HFBTHO_GAUSS_OBJ              = hfbtho_gauss.o
HFBTHO_STORAGE_OBJ            = hfbtho_storage.o
HFBTHO_GOGNY_OBJ              = hfbtho_gogny.o
HFBTHO_LOCALIZATION_OBJ       = hfbtho_localization.o
HFBTHO_MULTIPOLE_MOMENTS_OBJ  = hfbtho_multipole_moments.o
ifeq ($(USE_MPI), 0)
HFBTHO_LARGE_SCALE_OBJ        =
else
HFBTHO_LARGE_SCALE_OBJ        = hfbtho_large_scale.o
endif
HFBTHO_LIPKIN_OBJ             = hfbtho_lipkin.o
ifeq ($(READ_FUNCTIONAL), 1)
HFBTHO_READ_FUNCTIONAL_OBJ    = hfbtho_read_functional.o
else
HFBTHO_READ_FUNCTIONAL_OBJ    =
endif
HFBTHO_COLLECTIVE_OBJ         = hfbtho_collective.o
HFBTHO_FISSION_OBJ            = hfbtho_fission.o
HFBTHO_CANONICAL_OBJ          = hfbtho_canonical.o
HFBTHO_THO_OBJ                = hfbtho_tho.o
HFBTHO_PNP_OBJ                = hfbtho_pnp.o
HFBTHO_PROJECTIONS_OBJ        = hfbtho_projections.o
HFBTHO_IO_OBJ                 = hfbtho_io.o
HFBTHO_SOLVER_OBJ             = hfbtho_solver.o
HFBTHO_LIBRARY_OBJ            = hfbtho_library.o
HFBTHO_MAIN_OBJ               = hfbtho_main.o

# Build HFBTHO
all: $(HFBTHO_EXE) libhfbtho.a python

# Cleaning
clean :
	$(MAKE) clean -C doc
	-rm -f *.o *.oo *.ipo *.mod

# Deep cleaning
mrproper : clean
	rm -f $(HFBTHO_EXE) *.so libhfbtho.a hfbtho_main.c*

# =========================== DEPENDENCIES ===========================
# Build required dependencies for each source file
HFBTHO_VERSION_DEPS =
HFBTHO_UTILITIES_DEPS =
HFBTHO_ELLIPTIC_INTEGRALS_DEPS = $(HFBTHO_UTILITIES_OBJ)
HFBTHO_BESSEL_DEPS = $(HFBTHO_UTILITIES_OBJ)
HFBTHO_UNEDF_DEPS = $(HFBTHO_UTILITIES_OBJ)
HFBTHO_VARIABLES_DEPS = $(HFBTHO_UNEDF_OBJ) $(HFBTHO_VERSION_OBJ)
HFBTHO_MATH_DEPS = $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_GAUSS_DEPS = $(HFBTHO_MATH_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_CANONICAL_DEPS = $(HFBTHO_GAUSS_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_STORAGE_DEPS = $(HFBTHO_GAUSS_OBJ) $(HFBTHO_UNEDF_OBJ) $(HFBTHO_VARIABLES_OBJ)
HFBTHO_GOGNY_DEPS = $(HFBTHO_GAUSS_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UNEDF_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_LOCALIZATION_DEPS = $(HFBTHO_GAUSS_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_MULTIPOLE_MOMENTS_DEPS = $(HFBTHO_GAUSS_OBJ) $(HFBTHO_MATH_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_LIPKIN_DEPS = $(HFBTHO_CANONICAL_OBJ) $(HFBTHO_GAUSS_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UNEDF_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_LARGE_SCALE_DEPS = $(HFBTHO_LIPKIN_OBJ) $(HFBTHO_MULTIPOLE_MOMENTS_OBJ) $(HFBTHO_GAUSS_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
ifeq ($(READ_FUNCTIONAL), 1)
HFBTHO_READ_FUNCTIONAL_DEPS = $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UNEDF_OBJ) $(HFBTHO_UTILITIES_OBJ)
endif
HFBTHO_COLLECTIVE_DEPS = $(HFBTHO_MULTIPOLE_MOMENTS_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_FISSION_DEPS = $(HFBTHO_MULTIPOLE_MOMENTS_OBJ) $(HFBTHO_GAUSS_OBJ) \
                      $(HFBTHO_MATH_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_THO_DEPS = $(HFBTHO_GAUSS_OBJ) $(HFBTHO_MATH_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_PNP_DEPS = $(HFBTHO_MULTIPOLE_MOMENTS_OBJ) $(HFBTHO_CANONICAL_OBJ) $(HFBTHO_GAUSS_OBJ) $(HFBTHO_VARIABLES_OBJ) \
                  $(HFBTHO_UNEDF_OBJ) $(HFBTHO_BESSEL_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_PROJECTIONS_DEPS = $(HFBTHO_FISSION_OBJ) $(HFBTHO_MULTIPOLE_MOMENTS_OBJ) $(HFBTHO_GAUSS_OBJ) $(HFBTHO_VARIABLES_OBJ) \
                          $(HFBTHO_MATH_OBJ) $(HFBTHO_UNEDF_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_IO_DEPS = $(HFBTHO_THO_OBJ) $(HFBTHO_FISSION_OBJ) $(HFBTHO_LIPKIN_OBJ) $(HFBTHO_LARGE_SCALE_OBJ) $(HFBTHO_MULTIPOLE_MOMENTS_OBJ) \
                 $(HFBTHO_GOGNY_OBJ) $(HFBTHO_GAUSS_OBJ) $(HFBTHO_MATH_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UNEDF_OBJ) \
                 $(HFBTHO_UTILITIES_OBJ)
HFBTHO_SOLVER_DEPS = $(HFBTHO_IO_OBJ) $(HFBTHO_PNP_OBJ) $(HFBTHO_THO_OBJ) $(HFBTHO_FISSION_OBJ) $(HFBTHO_COLLECTIVE_OBJ) \
                     $(HFBTHO_LIPKIN_OBJ) $(HFBTHO_MULTIPOLE_MOMENTS_OBJ) $(HFBTHO_GOGNY_OBJ) $(HFBTHO_STORAGE_OBJ) \
                     $(HFBTHO_CANONICAL_OBJ) $(HFBTHO_GAUSS_OBJ) $(HFBTHO_MATH_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UNEDF_OBJ) \
                     $(HFBTHO_BESSEL_OBJ) $(HFBTHO_ELLIPTIC_INTEGRALS_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_LIBRARY_DEPS = $(HFBTHO_PROJECTIONS_OBJ) $(HFBTHO_SOLVER_OBJ) $(HFBTHO_IO_OBJ) $(HFBTHO_READ_FUNCTIONAL_OBJ) \
                      $(HFBTHO_LARGE_SCALE_OBJ) $(HFBTHO_LOCALIZATION_OBJ) $(HFBTHO_UNEDF_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_MAIN_DEPS = $(HFBTHO_LIBRARY_OBJ) $(HFBTHO_LARGE_SCALE_OBJ) $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UTILITIES_OBJ)
HFBTHO_ALL_DEPS = $(HFBTHO_LIBRARY_OBJ) $(HFBTHO_SOLVER_OBJ) $(HFBTHO_IO_OBJ) $(HFBTHO_PROJECTIONS_OBJ) $(HFBTHO_PNP_OBJ) \
                  $(HFBTHO_THO_OBJ) $(HFBTHO_FISSION_OBJ) $(HFBTHO_COLLECTIVE_OBJ) $(HFBTHO_READ_FUNCTIONAL_OBJ) \
                  $(HFBTHO_LIPKIN_OBJ) $(HFBTHO_LARGE_SCALE_OBJ) $(HFBTHO_MULTIPOLE_MOMENTS_OBJ) $(HFBTHO_LOCALIZATION_OBJ) \
                  $(HFBTHO_GOGNY_OBJ) $(HFBTHO_STORAGE_OBJ) $(HFBTHO_CANONICAL_OBJ) $(HFBTHO_GAUSS_OBJ) $(HFBTHO_MATH_OBJ) \
                  $(HFBTHO_VARIABLES_OBJ) $(HFBTHO_UNEDF_OBJ) $(HFBTHO_BESSEL_OBJ) $(HFBTHO_ELLIPTIC_INTEGRALS_OBJ) \
                  $(HFBTHO_UTILITIES_OBJ) $(HFBTHO_VERSION_OBJ)

# ============================== RULES ===============================
$(HFBTHO_VERSION_OBJ)            : hfbtho_version.f90 $(HFBTHO_VERSION_DEPS)
$(HFBTHO_UTILITIES_OBJ)          : hfbtho_utilities.f90 $(HFBTHO_UTILITIES_DEPS)
$(HFBTHO_ELLIPTIC_INTEGRALS_OBJ) : hfbtho_elliptic_integrals.f90 $(HFBTHO_ELLIPTIC_INTEGRALS_DEPS)
$(HFBTHO_BESSEL_OBJ)             : hfbtho_bessel.f90 $(HFBTHO_BESSEL_DEPS)
$(HFBTHO_UNEDF_OBJ)              : hfbtho_unedf.f90 $(HFBTHO_UNEDF_DEPS)
$(HFBTHO_VARIABLES_OBJ)          : hfbtho_variables.f90 $(HFBTHO_VARIABLES_DEPS)
$(HFBTHO_MATH_OBJ)               : hfbtho_math.f90 $(HFBTHO_MATH_DEPS)
$(HFBTHO_GAUSS_OBJ)              : hfbtho_gauss.f90 $(HFBTHO_GAUSS_DEPS)
$(HFBTHO_CANONICAL_OBJ)          : hfbtho_canonical.f90 $(HFBTHO_CANONICAL_DEPS)
$(HFBTHO_STORAGE_OBJ)            : hfbtho_storage.f90 $(HFBTHO_STORAGE_DEPS)
$(HFBTHO_GOGNY_OBJ)              : hfbtho_gogny.f90 $(HFBTHO_GOGNY_DEPS)
$(HFBTHO_LOCALIZATION_OBJ)       : hfbtho_localization.f90 $(HFBTHO_LOCALIZATION_DEPS)
$(HFBTHO_MULTIPOLE_MOMENTS_OBJ)  : hfbtho_multipole_moments.f90 $(HFBTHO_MULTIPOLE_MOMENTS_DEPS)
$(HFBTHO_LARGE_SCALE_OBJ)        : hfbtho_large_scale.f90 $(HFBTHO_LARGE_SCALE_DEPS)
$(HFBTHO_LIPKIN_OBJ)             : hfbtho_lipkin.f90 $(HFBTHO_LIPKIN_DEPS)
$(HFBTHO_READ_FUNCTIONAL_OBJ)    : hfbtho_read_functional.f90 $(HFBTHO_READ_FUNCTIONAL_DEPS)
$(HFBTHO_COLLECTIVE_OBJ)         : hfbtho_collective.f90 $(HFBTHO_COLLECTIVE_DEPS)
$(HFBTHO_FISSION_OBJ)            : hfbtho_fission.f90 $(HFBTHO_FISSION_DEPS)
$(HFBTHO_THO_OBJ)                : hfbtho_tho.f90 $(HFBTHO_THO_DEPS)
$(HFBTHO_PNP_OBJ)                : hfbtho_pnp.f90 $(HFBTHO_PNP_DEPS)
$(HFBTHO_PROJECTIONS_OBJ)        : hfbtho_projections.f90 $(HFBTHO_PROJECTIONS_DEPS)
$(HFBTHO_IO_OBJ)                 : hfbtho_io.f90 $(HFBTHO_IO_DEPS)
$(HFBTHO_SOLVER_OBJ)             : hfbtho_solver.f90 $(HFBTHO_SOLVER_DEPS)
$(HFBTHO_LIBRARY_OBJ)            : hfbtho_library.f90 $(HFBTHO_LIBRARY_DEPS)
$(HFBTHO_MAIN_OBJ)               : hfbtho_main.f90 $(HFBTHO_MAIN_DEPS)

# Compiling
%.o: %.f90
ifeq ($(VERBOSE),1)
	$(FORTRAN_MPI) -c $< $(FORMAT_F90) $(OPTIONS)
else
	@echo "Compiling  \"$@\"..."
	@$(FORTRAN_MPI) -c $< $(FORMAT_F90) $(OPTIONS)
endif

# HFBTHO: executable
$(HFBTHO_EXE): $(HFBTHO_ALL_DEPS) $(HFBTHO_MAIN_OBJ)
ifeq ($(VERBOSE),1)
	$(FORTRAN_MPI) $(FORMAT_F90) $(OPTIONS) -o $@ $^ $(LINEAR_ALGEBRA)
else
	@echo "Linking \"$@\"..."
	@$(FORTRAN_MPI) $(FORMAT_F90) $(OPTIONS) -o $@ $^ $(LINEAR_ALGEBRA)
endif

# HFBTHO: static library
libhfbtho.a: $(HFBTHO_ALL_DEPS)
ifeq ($(VERBOSE),1)
	ar rcs $@ $^
else
	@echo "Building library \"$@\"..."
	@ar rcs $@ $^
endif

# HFBTHO: Python bindings
python : $(HFBTHO_ALL_DEPS) $(HFBTHO_LIBRARY_OBJ)
	@echo "Creating Python bindings..."
	$(F2PY) -c --f90exec=$(FORTRAN_MPI) --f90flags='$(FORMAT_F2PY)' --opt='$(OPTIONS_F2PY)' -m hfbtho_library hfbtho_library.f90 -L. -lhfbtho $(LINEAR_ALGEBRA) $(THREAD_LIBRARY)
