      G1(I,J)=U(I,MIX)*QEL(I,J,2,MIX)                                           
  375 G2(I,J)=V(I,MIX)*QEL(I,J,2,MIX)                                           
      DO 376 I=1,NL                                                             
      DO 376 J=1,NL                                                             
      T11PMU(I,J+NL,1,MIX)=G2(I,J)*U(J,MIX)                                     
      T20PMU(I,J,1,MIX)=G2(I,J)*V(J,MIX)                                        
  376 T02PMU(I+NL,J+NL,1,MIX)=-G1(I,J)*U(J,MIX)                                 
