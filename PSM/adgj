     1                SEL(NMD,NMD,3,6),REL(NMD,NMD,3,6),                        
     2                HEL(NMD,NMD,6),AMP(NMD,NMD,6)                             
C                                                                               
      IF (NPQP.NE.2) RETURN                                                     
