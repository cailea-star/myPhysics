      T20HQ(I,J+NL,MIX)=-G1(I,J)*V(J,MIX)-G2(I,J)*U(J,MIX)                      
      T20HQ(I+NL,J,MIX)=-T20HQ(I,J+NL,MIX)                                      
      T02HQ(I,J+NL,MIX)=T20HQ(I,J+NL,MIX)                                       
  112 T02HQ(I+NL,J,MIX)=-T02HQ(I,J+NL,MIX)                                      
