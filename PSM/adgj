C                                                                               
      SUBROUTINE LARGE(MD2,MD,NL,B1,B2,B,K123)                                  
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      DIMENSION B(MD2,MD2),B1(MD,MD),B2(MD,MD)                                  
C                                                                               
      IF (K123) 5,6,7                                                           
    5 DO 3 I=1,NL                                                               
      DO 3 J=1,NL                                                               
      B(I,J)      =-B2(I,J)                                                     
      B(I,J+NL)   =-B1(I,J)                                                     
      B(I+NL,J)   = B1(I,J)                                                     
      B(I+NL,J+NL)=-B2(I,J)                                                     
    3 CONTINUE                                                                  
      GOTO 10                                                                   
C                                                                               
    6 DO 2 I=1,NL                                                               
      DO 2 J=1,NL                                                               
      B(I,J)      =-B1(I,J)                                                     
      B(I,J+NL)   = B2(I,J)                                                     
      B(I+NL,J)   =-B2(I,J)                                                     
      B(I+NL,J+NL)=-B1(I,J)                                                     
    2 CONTINUE                                                                  
      GOTO 10                                                                   
C                                                                               
    7 DO 1 I=1,NL                                                               
      DO 1 J=1,NL                                                               
      B(I,J)      = B1(I,J)                                                     
      B(I,J+NL)   = B2(I,J)                                                     
      B(I+NL,J)   =-B2(I,J)                                                     
      B(I+NL,J+NL)= B1(I,J)                                                     
    1 CONTINUE                                                                  
   10 CONTINUE                                                                  
      END                                                                       
