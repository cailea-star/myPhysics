      SUBROUTINE LEGEND                                                         
C                                                                               
      INCLUDE 'OE_PARA'                                                         
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      COMMON /GAUSSL/ X(NNDEG),W(NNDEG),WEIT(NNDEG),N                           
      DIMENSION GAMMA(NNDEG)                                                    
C                                                                               
      H=0.                                                                      
      DO 1 J=1,N                                                                
      H=H+2.                                                                    
      H1=J-1                                                                    
    1 GAMMA(J)=-H1*H1/(H-1.)/(H-3.)                                             
      NP1=N+1                                                                   
      NM1=N-1                                                                   
      Q=1                                                                       
      I=N/2                                                                     
      TEST=N/2.-I-0.1                                                           
      IF (TEST) 2,2,3                                                           
    2 J=I+1                                                                     
      GO TO 4                                                                   
    3 X(I+1)=0                                                                  
      J=I+2                                                                     
    4 H=0                                                                       
      DO 14 K=J,N                                                               
      DOWN=H                                                                    
      UP=1                                                                      
    5 M=0                                                                       
      EWN=(UP+DOWN)/2.                                                          
      DO 9 II=1,N                                                               
      IF (Q) 7,6,7                                                              
    6 Q=1.D-15                                                                  
    7 Q=GAMMA(II)/Q-EWN                                                         
      IF (Q) 8,9,9                                                              
    8 M=M+1                                                                     
    9 CONTINUE                                                                  
      IF (K-M) 10,10,11                                                         
   10 UP=EWN                                                                    
      GO TO 12                                                                  
   11 DOWN=EWN                                                                  
   12 Q=1.D-12-(UP-DOWN)                                                        
      IF (Q) 5,13,13                                                            
   13 H=(UP+DOWN)/2.                                                            
      X(K)=-H                                                                   
   14 X(NP1-K)=H                                                                
      J=I+1                                                                     
      DO 16 K=J,N                                                               
      SUM=1                                                                     
      UP=1                                                                      
      DOWN=0                                                                    
      H1=X(K)                                                                   
      DO 15 II=1,NM1                                                            
      H=2*II                                                                    
      Q=((H-1.)*H1*UP-(II-1)*DOWN)/II                                           
      SUM=SUM+Q*Q*(H+1.)                                                        
      DOWN=UP                                                                   
   15 UP=Q                                                                      
      W(K)=2./SUM                                                               
   16 W(NP1-K)=W(K)                                                             
C                                                                               
      END                                                                       
