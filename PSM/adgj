  359 G2(I,J)=V(I,MIX)*QEL(I,J,1,MIX)                                           
      DO 340 I=1,NL                                                             
      DO 340 J=1,NL                                                             
      T11PMU(I,J,2,MIX)=-G2(I,J)*U(J,MIX)                                       
      T20PMU(I,J+NL,2,MIX)=G2(I,J)*V(J,MIX)                                     
