      SUBROUTINE ELEM01(IBET,JBET,HR00)                                         
C                                                                               
      INCLUDE 'EO_PARA'                                                         
      PARAMETER (MD2=2*NMD)                                                     
      PARAMETER (NNDEH=NNDEG/2)                                                 
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      COMMON /HMILTN/ HM1(NNRANK,4),HM2(NNRANK,NNRANK,6),                       
     1                HM3(NNATA,2),HM4(NNATA,NNRANK,2),                         
     2                HM5(NNRANK,NNATA,2),HM6(NNATA,NNATA)                      
      COMMON /INTRUD/ ITINT(2),NNINT(2),MIXINT(2),NLINT(2)                      
      COMMON /NORHAM/ WK1(NNRANT,NNRANT,2,NNDEH),                               
     1                WK2(NNRANT,NNRANT,2,NNDEH)                                
      COMMON /TQB   / ETQ3(NNTQ3),AKTQ3(NNTQ3),ITQ3(NNTQ3,3),                   
     1                KTQ3(NNTQ3),NTQ3,NTQH3                                    
      COMMON /TQB1  / NOQ(2),NOQR(2),IOQ(2,MD2),IOQR(2,MD2),                    
     1                NTQ(3),NTQH(2)                                            
      COMMON /TQB2  / ETQ(NNRANT),KTQ(NNRANT),ITQ(NNRANT,3),NRANK               
      COMMON /TQB3  / IOQB(2,MD2),ITQB(2,NNATA,2),NATA(2)                       
      COMMON /TINQAS/ AA(MD2,MD2,2),BB(MD2,MD2,2),CC(MD2,MD2,2)                 
C                                                                               
      WRITE(*,100)                                                              
  100 FORMAT(20('*'),' ELEM01')                                                 
C                                                                               
C     <AP H AP>                                                                 
C                                                                               
      NOQR2 = NOQR(2)*2                                                         
      DO 1 I1 = 1,NOQR(2)                                                       
      DO 1 I2 = 1,NOQR(2)                                                       
      J1=IOQB(2,I1)                                                             
      J2=IOQB(2,I2)                                                             
      N12 = 0                                                                   
      DO 25 N1 = 1,NOQR2                                                        
      DO 25 N2 = 1,NOQR2                                                        
      N12 = N12 + 1                                                             
      IF (IOQB(2,N1).EQ.J2.AND.IOQB(2,N2).EQ.J1) GOTO 26                        
   25 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM01 25'                                   
      WRITE(*,*) ' STOP: FEHLER IN ELEM01 25'                                   
      STOP                                                                      
   26 CONTINUE                                                                  
      WK1(I1,I2,JBET,IBET)=CC(J1,J2,2)                                          
      WK2(I1,I2,JBET,IBET)=CC(J1,J2,2)*HR00 + HM3(N12,2)                        
    1 CONTINUE                                                                  
C                                                                               
C     <AP H AN AN AP>                                                           
C                                                                               
      DO 8 I1 = 1,NOQR(2)                                                       
      DO 8 I2 = 1,NTQ3                                                          
      I21=ITQ3(I2,1)                                                            
      I22=ITQ3(I2,2)                                                            
      J1 =IOQB(2,I1)                                                            
      J21=ITQ(I21,1)                                                            
      J22=ITQ(I21,2)                                                            
      J23=IOQB(2,I22)                                                           
      ANORM = AA(J21,J22,1)*CC(J1,J23,2)                                        
      SUM=ANORM*HR00                                                            
      SUM=SUM+CC(J1,J23,2)*HM1(I21,3)                                           
C                                                                               
      N12 = 0                                                                   
      DO 27 N1 = 1,NOQR2                                                        
      DO 27 N2 = 1,NOQR2                                                        
      N12 = N12 + 1                                                             
      IF (IOQB(2,N1).EQ.J23.AND.IOQB(2,N2).EQ.J1) GOTO 28                       
   27 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM01 27'                                   
      WRITE(*,*) ' STOP: FEHLER IN ELEM01 27'                                   
      STOP                                                                      
   28 SUM=SUM + AA(J21,J22,1)*HM3(N12,2) + HM5(I21,N12,1)                       
C                                                                               
      WK1(I1,NOQR(2)+I2,JBET,IBET)=ANORM                                        
      WK2(I1,NOQR(2)+I2,JBET,IBET)=SUM                                          
    8 CONTINUE                                                                  
C                                                                               
C     <AP AN AN H AP>                                                           
C                                                                               
      DO 9 I1 = 1,NTQ3                                                          
      DO 9 I2 = 1,NOQR(2)                                                       
      I11=ITQ3(I1,1)                                                            
      I12=ITQ3(I1,2)                                                            
      J2 =IOQB(2,I2)                                                            
      J11=ITQ(I11,1)                                                            
      J12=ITQ(I11,2)                                                            
      J13=IOQB(2,I12)                                                           
      ANORM = BB(J12,J11,1)*CC(J13,J2,2)                                        
      SUM=ANORM*HR00                                                            
      SUM=SUM+CC(J13,J2,2)*HM1(I11,1)                                           
C                                                                               
      N12 = 0                                                                   
      DO 21 N1 = 1,NOQR2                                                        
      DO 21 N2 = 1,NOQR2                                                        
      N12 = N12 + 1                                                             
      IF (IOQB(2,N1).EQ.J2.AND.IOQB(2,N2).EQ.J13) GOTO 22                       
   21 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM01 21'                                   
      STOP                                                                      
   22 SUM=SUM + BB(J12,J11,1)*HM3(N12,2) + HM5(I11,N12,2)                       
C                                                                               
      WK1(NOQR(2)+I1,I2,JBET,IBET)=ANORM                                        
      WK2(NOQR(2)+I1,I2,JBET,IBET)=SUM                                          
    9 CONTINUE                                                                  
C                                                                               
C     < AP AN AN H AN AN AP >                                                   
C                                                                               
      DO 70 I1 = 1,NTQ3                                                         
      DO 70 I2 = 1,NTQ3                                                         
      I11=ITQ3(I1,1)                                                            
      I12=ITQ3(I1,2)                                                            
      I21=ITQ3(I2,1)                                                            
      I22=ITQ3(I2,2)                                                            
      J1=IOQB(2,I12)                                                            
      J2=IOQB(2,I22)                                                            
      J11=ITQ(I11,1)                                                            
      J12=ITQ(I11,2)                                                            
      J21=ITQ(I21,1)                                                            
      J22=ITQ(I21,2)                                                            
C                                                                               
      A4N = AA(J12,J11,1)*BB(J21,J22,1)                                         
     1    + CC(J12,J22,1)*CC(J11,J21,1)                                         
     2    - CC(J12,J21,1)*CC(J11,J22,1)                                         
      ANORM=CC(J1,J2,2)*A4N                                                     
      SUM=ANORM*HR00                                                            
      SUM=SUM + CC(J1,J2,2)*BB(J12,J11,1)*HM1(I21,3)                            
     1        + CC(J1,J2,2)*AA(J21,J22,1)*HM1(I11,1)                            
     2        + CC(J1,J2,2)*HM2(I21,I11,5)                                      
C                                                                               
      N12 = 0                                                                   
      DO 75 N1 = 1,NOQR2                                                        
      DO 75 N2 = 1,NOQR2                                                        
      N12 = N12 + 1                                                             
      IF (IOQB(2,N1).EQ.J2.AND.IOQB(2,N2).EQ.J1) GOTO 76                        
   75 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM01 75'                                   
      STOP                                                                      
   76 CONTINUE                                                                  
      SUM=SUM + A4N*HM3(N12,2)                                                  
     1        + AA(J21,J22,1)*HM5(I11,N12,2)                                    
     2        + BB(J12,J11,1)*HM5(I21,N12,1)                                    
C                                                                               
      NOQR1 = NOQR(1)*2                                                         
      N21 = 0                                                                   
      DO 111 N1 = 1,NOQR1                                                       
      DO 111 N2 = 1,NOQR1                                                       
      N21 = N21 + 1                                                             
      IF (IOQB(1,N1).EQ.J21.AND.IOQB(1,N2).EQ.J11) GOTO 112                     
  111 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM01 111'                                  
      STOP                                                                      
  112 CONTINUE                                                                  
      SUM=SUM + CC(J1,J2,2)*CC(J12,J22,1)*HM3(N21,1)                            
     1        + CC(J12,J22,1)*HM6(N21,N12)                                      
C                                                                               
      N21 = 0                                                                   
      DO 113 N1 = 1,NOQR1                                                       
      DO 113 N2 = 1,NOQR1                                                       
      N21 = N21 + 1                                                             
      IF (IOQB(1,N1).EQ.J21.AND.IOQB(1,N2).EQ.J12) GOTO 114                     
  113 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM01 113'                                  
      STOP                                                                      
  114 CONTINUE                                                                  
      SUM=SUM - CC(J1,J2,2)*CC(J11,J22,1)*HM3(N21,1)                            
     1        - CC(J11,J22,1)*HM6(N21,N12)                                      
C                                                                               
      N21 = 0                                                                   
      DO 115 N1 = 1,NOQR1                                                       
      DO 115 N2 = 1,NOQR1                                                       
      N21 = N21 + 1                                                             
      IF (IOQB(1,N1).EQ.J22.AND.IOQB(1,N2).EQ.J12) GOTO 116                     
  115 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM01 115'                                  
      STOP                                                                      
  116 CONTINUE                                                                  
      SUM=SUM + CC(J1,J2,2)*CC(J11,J21,1)*HM3(N21,1)                            
     1        + CC(J11,J21,1)*HM6(N21,N12)                                      
C                                                                               
      N21 = 0                                                                   
      DO 117 N1 = 1,NOQR1                                                       
      DO 117 N2 = 1,NOQR1                                                       
      N21 = N21 + 1                                                             
      IF (IOQB(1,N1).EQ.J22.AND.IOQB(1,N2).EQ.J11) GOTO 118                     
  117 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM01 117'                                  
      STOP                                                                      
  118 CONTINUE                                                                  
      SUM=SUM - CC(J1,J2,2)*CC(J12,J21,1)*HM3(N21,1)                            
     1        - CC(J12,J21,1)*HM6(N21,N12)                                      
C                                                                               
      WK1(NOQR(2)+I1,NOQR(2)+I2,JBET,IBET) = ANORM                              
      WK2(NOQR(2)+I1,NOQR(2)+I2,JBET,IBET) = SUM                                
   70 CONTINUE                                                                  
C                                                                               
      END                                                                       
C                                                                               
C                                                                               
      SUBROUTINE BASE01                                                         
C                                                                               
C************************************************************                   
C        QUANTUM NUMBERS OF TWO-QUASIPARTICLE STATES        *                   
C     ITQ(IL,1)    INDEX OF A 2-NEUTRON STATE 'IL'          *                   
C     ITQ(IL,2)    INDEX OF A 2-PROTON  STATE 'IL'          *                   
C     ITQ(IL,3)    1/2 FOR K1 +/- K2; 0 FOR PAIRED 2-QP     *                   
C     KTQ(IL)      K-QUANTUM-NUMBER   K1 +/- K2             *                   
C     ETQ(IL)      QUASIPARTICLE-ENERGY E1 + E2             *                   
C************************************************************                   
C                                                                               
      INCLUDE 'EO_PARA'                                                         
      PARAMETER (MD2=2*NMD)                                                     
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      COMMON /CONFIG/ MXSH(2),NPSH(3,2),NILS(3,2)                               
      COMMON /INTRUD/ ITINT(2),NNINT(2),MIXINT(2),NLINT(2)                      
      COMMON /MAXMAX/ EMAX(3),KMAX(3),NMAX(3),JMAX                              
      COMMON /TQB   / ETQ3(NNTQ3),AKTQ3(NNTQ3),ITQ3(NNTQ3,3),                   
     1                KTQ3(NNTQ3),NTQ3,NTQH3                                    
      COMMON /TQB1  / NOQ(2),NOQR(2),IOQ(2,MD2),IOQR(2,MD2),                    
     1                NTQ(3),NTQH(2)                                            
      COMMON /TQB2  / ETQ(NNRANT),KTQ(NNRANT),ITQ(NNRANT,3),NRANK               
      COMMON /TQB3  / IOQB(2,MD2),ITQB(2,NNATA,2),NATA(2)                       
      COMMON /TQBM  / ETQM(2,NNRANK),KTQM(2,NNRANK),ITQM(2,NNRANK,3)            
      COMMON /UVUV  / ESP(NMD,6),EQP(NMD,6),U(NMD,6),V(NMD,6),                  
     1                KQN(NMD,6)                                                
C                                                                               
      DIMENSION MI(2),MF(2),AETQ3(NNTQ3)                                        
C                                                                               
      CHARACTER*15 TITLE                                                        
C                                                                               
      NP=0                                                                      
      MP=0                                                                      
      DO 15 J=1,2                                                               
      MS=MXSH(J)                                                                
      DO 15 I=1,MS                                                              
      MP=MP+1                                                                   
   15 IF (NILS(I,J).GT.NP) NP=NILS(I,J)                                         
C                                                                               
      WRITE(1,*)                                                                
      WRITE(1,*) ' SINGLE-PARTICLE BASIS'                                       
      WRITE(1,*) ' ~~~~~~~~~~~~~~~~~~~~~'                                       
      WRITE(1,*)                                                                
C                                                                               
      TITLE='NILSSON LEVELS:'                                                   
      WRITE(1,115) TITLE,MXSH,((NPSH(I,J),I=1,MXSH(J)),J=1,2)                   
      DO 16 I=1,NP                                                              
   16 WRITE(1,116) I,(KQN(I,J),ESP(I,J),J=1,MP)                                 
      WRITE(1,*)                                                                
      WRITE(1,*)                                                                
      TITLE='QUASIPARTICLES:'                                                   
      WRITE(1,115) TITLE,MXSH,((NPSH(I,J),I=1,MXSH(J)),J=1,2)                   
      DO 17 I=1,NP                                                              
   17 WRITE(1,116) I,(KQN(I,J),EQP(I,J),J=1,MP)                                 
      WRITE(1,*)                                                                
C                                                                               
      WRITE(1,*)                                                                
      WRITE(1,*) ' MULTI-QUASIPARTICLE BASIS'                                   
      WRITE(1,*) ' ~~~~~~~~~~~~~~~~~~~~~~~~~'                                   
C                                                                               
      DO 3 IT=1,2                                                               
      IF (IT.EQ.1) THEN                                                         
        WRITE(1,111)                                                            
        WRITE(1,101) KMAX(IT),EMAX(IT),NMAX(IT)                                 
      ELSE                                                                      
        WRITE(1,112)                                                            
        WRITE(1,102) KMAX(IT),EMAX(IT),NMAX(IT)                                 
      ENDIF                                                                     
      WRITE(1,110) MIXINT(IT),NNINT(IT),NLINT(IT)                               
      II=0                                                                      
      DO 1 I=1,NLINT(IT)                                                        
      II=II+1                                                                   
      IOQ(IT,I)=I                                                               
      IOQR(IT,I)=I                                                              
    1 IOQR(IT,I+NLINT(IT))=I+NLINT(IT)                                          
      NOQ(IT)=II                                                                
C-------------------------------------------------------------------            
C     CHOICE OF THE PAIRS                                                       
C-------------------------------------------------------------------            
      LOW=1                                                                     
      ELOW=EQP(1,MIXINT(IT))                                                    
      DO 50 I=1,NLINT(IT)                                                       
      IF (EQP(I,MIXINT(IT)).GE.ELOW) GOTO 50                                    
      LOW=I                                                                     
      ELOW=EQP(I,MIXINT(IT))                                                    
   50 CONTINUE                                                                  
      NH=NMAX(IT)/2                                                             
      MI(IT)=MAX(1,LOW-NH/2)                                                    
      MF(IT)=MIN(NLINT(IT),MI(IT)+NH-1)                                         
      IF (MI(IT).EQ.1) MF(IT)=MI(IT)+NH-1                                       
      IF (MF(IT).EQ.NLINT(IT)) MI(IT)=MF(IT)-NH+1                               
C                                                                               
      IL = 0                                                                    
      DO 7 I1=MI(IT),MF(IT)                                                     
      EQP1=EQP(I1,MIXINT(IT))                                                   
      KQP1=KQN(I1,MIXINT(IT))                                                   
      IF (IT.EQ.2.AND.EQP1.GT.EMAX(IT)) GOTO 7                                  
      IF (IT.EQ.2.AND.IABS(KQP1).GT.KMAX(IT)) GOTO 7                            
      DO 8 I2=I1,MF(IT)                                                         
      IF (IL.GE.NMAX(IT)/2) GOTO 9                                              
      IF (I1.EQ.I2) GOTO 8                                                      
      EQP2=EQP(I2,MIXINT(IT))                                                   
      KQP2=KQN(I2,MIXINT(IT))                                                   
      IF (IT.EQ.2.AND.EQP2.GT.EMAX(IT)) GOTO 8                                  
      IF (IT.EQ.2.AND.IABS(KQP2).GT.KMAX(IT)) GOTO 8                            
      ECHK = EQP1+EQP2                                                          
      KCHK =(KQP1+KQP2)/2                                                       
      IF (IT.EQ.1.AND.ECHK.GT.EMAX(IT)) GOTO 8                                  
      IF (IT.EQ.1.AND.IABS(KCHK).GT.KMAX(IT)) GOTO 8                            
      IL = IL + 1                                                               
      ITQM(IT,IL,1)=I1                                                          
      ITQM(IT,IL,2)=I2                                                          
      ITQM(IT,IL,3)=1                                                           
      KTQM(IT,IL)=KCHK                                                          
      ETQM(IT,IL)=ECHK                                                          
    8 CONTINUE                                                                  
    7 CONTINUE                                                                  
    9 NTQH(IT) = IL                                                             
C                                                                               
      DO 11 I1=MI(IT),MF(IT)                                                    
      EQP1=EQP(I1,MIXINT(IT))                                                   
      KQP1=KQN(I1,MIXINT(IT))                                                   
      IF (IT.EQ.2.AND.EQP1.GT.EMAX(IT)) GOTO 11                                 
      IF (IT.EQ.2.AND.IABS(KQP1).GT.KMAX(IT)) GOTO 11                           
      DO 12 I2=I1,MF(IT)                                                        
      IF (IL.GE.NMAX(IT)) GOTO 13                                               
      EQP2=EQP(I2,MIXINT(IT))                                                   
      KQP2=KQN(I2,MIXINT(IT))                                                   
      IF (IT.EQ.2.AND.EQP2.GT.EMAX(IT)) GOTO 12                                 
      IF (IT.EQ.2.AND.IABS(KQP2).GT.KMAX(IT)) GOTO 12                           
      ECHK = EQP1+EQP2                                                          
      KCHK =(KQP1-KQP2)/2                                                       
      IF (IT.EQ.1.AND.ECHK.GT.EMAX(IT)) GOTO 12                                 
      IF (IT.EQ.1.AND.IABS(KCHK).GT.KMAX(IT)) GOTO 12                           
      IL = IL + 1                                                               
      ITQM(IT,IL,1)=I1                                                          
      ITQM(IT,IL,2)=I2                                                          
      ITQM(IT,IL,3)=2                                                           
      IF (I1.EQ.I2) ITQM(IT,IL,3)=0                                             
      KTQM(IT,IL)=KCHK                                                          
      ETQM(IT,IL)=ECHK                                                          
   12 CONTINUE                                                                  
   11 CONTINUE                                                                  
   13 NTQ(IT) = IL                                                              
C                                                                               
      CALL ORD2QP(IT)                                                           
C                                                                               
C---------------------------------------------------------------------          
C     FIND THE RELEVANT SINGLE PARTICLE STATES                                  
C---------------------------------------------------------------------          
C                                                                               
      II=0                                                                      
      DO 20 I1=1,NOQ(IT)                                                        
      DO 21 I2=1,NTQ(IT)                                                        
      IF (IOQ(IT,I1).EQ.ITQM(IT,I2,1).OR.                                       
     1    IOQ(IT,I1).EQ.ITQM(IT,I2,2)) THEN                                     
        II=II+1                                                                 
        IOQ(IT,II)=IOQ(IT,I1)                                                   
        IOQR(IT,IOQ(IT,II))=II                                                  
        GOTO 20                                                                 
      ENDIF                                                                     
   21 CONTINUE                                                                  
   20 CONTINUE                                                                  
      NOQR(IT)=II                                                               
C                                                                               
C     NOQR(IT) is the Number of Relevant One Quasiparticle States               
C                                                                               
      NOQR2=NOQR(IT)*2                                                          
      N12=NOQR2*NOQR2                                                           
      IF (N12.GT.NNATA) THEN                                                    
        WRITE(*,*) ' SET NNATA IN EO_PARA FILE TO',N12                          
        STOP                                                                    
      ENDIF                                                                     
      N12 = 0                                                                   
      DO 27 I1=1,NOQR2                                                          
      DO 27 I2=1,NOQR2                                                          
      N12 = N12 + 1                                                             
      ITQB(IT,N12,1)=I1                                                         
   27 ITQB(IT,N12,2)=I2                                                         
      NATA(IT) = N12                                                            
      DO 28 I=1,NOQR(IT)                                                        
      IOQB(IT,I)=IOQ(IT,I)                                                      
   28 IOQB(IT,I+NOQR(IT))=IOQ(IT,I)+NLINT(IT)                                   
C                                                                               
      IIN=NTQH(IT)+1                                                            
      DO 24 II=IIN,NTQ(IT)                                                      
   24 ITQM(IT,II,2) = ITQM(IT,II,2)+NLINT(IT)                                   
C---------------------------------------------------------------------          
C     PRINT OUT                                                                 
C---------------------------------------------------------------------          
      WRITE(1,104) NOQR(IT)                                                     
      DO 30 I1=1,NOQR(IT)                                                       
      II=IOQ(IT,I1)                                                             
      UMV = U(II,MIXINT(IT))**2-V(II,MIXINT(IT))**2                             
      UV  = U(II,MIXINT(IT))*V(II,MIXINT(IT))                                   
      WRITE(1,105) I1,IOQ(IT,I1),KQN(IOQ(IT,I1),MIXINT(IT)),                    
     1      EQP(IOQ(IT,I1),MIXINT(IT)),UMV,UV,                                  
     2      U(II,MIXINT(IT)),V(II,MIXINT(IT))                                   
   30 CONTINUE                                                                  
      IF (IT.EQ.2) GOTO 32                                                      
      WRITE(1,106) NTQ(IT),NTQH(IT)                                             
      DO 31 II = 1,NTQ(IT)                                                      
      I1 = ITQM(IT,II,1)                                                        
      IF (II.LE.NTQH(IT)) THEN                                                  
        I2 = ITQM(IT,II,2)                                                      
      ELSE                                                                      
        I2 = ITQM(IT,II,2)-NLINT(IT)                                            
      ENDIF                                                                     
C                                                                               
      UMV = U(I1,MIXINT(IT))**2 - V(I1,MIXINT(IT))**2                           
     1    + U(I2,MIXINT(IT))**2 - V(I2,MIXINT(IT))**2                           
      UV  = U(I1,MIXINT(IT))*V(I1,MIXINT(IT))                                   
     1     +U(I2,MIXINT(IT))*V(I2,MIXINT(IT))                                   
      WRITE(1,107) II,(ITQM(IT,II,J),J=1,3),KTQM(IT,II),                        
     1             ETQM(IT,II),UMV,UV                                           
   31 CONTINUE                                                                  
   32 CONTINUE                                                                  
      WRITE(1,*)                                                                
C                                                                               
    3 CONTINUE                                                                  
C-----------------------------------                                            
C     REARANGEMENT                                                              
C-----------------------------------                                            
      II=0                                                                      
      DO 4 IT=1,2                                                               
      DO 4 I=1,NTQ(IT)                                                          
      II=II+1                                                                   
      KTQ(II) = KTQM(IT,I)                                                      
      ETQ(II) = ETQM(IT,I)                                                      
      DO 4 J=1,3                                                                
      ITQ(II,J) = ITQM(IT,I,J)                                                  
    4 CONTINUE                                                                  
C-------------------------------                                                
C     3-QP STATES                                                               
C-------------------------------                                                
      NH=NTQ(1)/2                                                               
      LI = 0                                                                    
      DO 53 I=1,NH                                                              
      EQP1=ETQ(I)                                                               
      KQP1=KTQ(I)                                                               
      IF (EQP1.GT.EMAX(1)) GOTO 53                                              
      IF (IABS(KQP1).GT.KMAX(1)) GOTO 53                                        
      DO 55 J=1,NOQR(2)                                                         
      IF (LI.GE.NMAX(3)/2) GOTO 54                                              
      EQP2=EQP(IOQ(2,J),MIXINT(2))                                              
      KQP2=KQN(IOQ(2,J),MIXINT(2))                                              
      IF (EQP2.GT.EMAX(2)) GOTO 55                                              
      IF (IABS(KQP2).GT.KMAX(2)) GOTO 55                                        
      ESUM = EQP1 + EQP2                                                        
      KSUM = KQP1*2 + KQP2                                                      
      IF (ESUM.GT.EMAX(3)) GOTO 55                                              
      IF (IABS(KSUM).GT.KMAX(3)) GOTO 55                                        
      LI = LI + 1                                                               
      KTQ3(LI)=KSUM                                                             
      AETQ3(LI)=ESUM                                                            
      ITQM(1,LI,1)=I                                                            
      ITQM(1,LI,2)=J                                                            
      ITQM(1,LI,3)=1                                                            
   55 CONTINUE                                                                  
   53 CONTINUE                                                                  
   54 NTQH3 = LI                                                                
C                                                                               
      DO 63 I=1,NH                                                              
      IF (ITQ(I,3).EQ.0) GOTO 63                                                
      EQP1=ETQ(I)                                                               
      KQP1=KTQ(I)                                                               
      IF (EQP1.GT.EMAX(1)) GOTO 63                                              
      IF (IABS(KQP1).GT.KMAX(1)) GOTO 63                                        
      DO 65 J=1,NOQR(2)                                                         
      IF (LI.GE.NMAX(3)) GOTO 64                                                
      EQP2=EQP(IOQ(2,J),MIXINT(2))                                              
      KQP2=KQN(IOQ(2,J),MIXINT(2))                                              
      IF (EQP2.GT.EMAX(2)) GOTO 65                                              
      IF (IABS(KQP2).GT.KMAX(2)) GOTO 65                                        
      ESUM = EQP1 + EQP2                                                        
      KSUM = KQP1*2 - KQP2                                                      
      IF (ESUM.GT.EMAX(3)) GOTO 65                                              
      IF (IABS(KSUM).GT.KMAX(3)) GOTO 65                                        
      LI = LI + 1                                                               
      KTQ3(LI)=KSUM                                                             
      AETQ3(LI)=ESUM                                                            
      ITQM(1,LI,1)=I                                                            
      ITQM(1,LI,2)=J+NOQR(2)                                                    
      ITQM(1,LI,3)=2                                                            
   65 CONTINUE                                                                  
   63 CONTINUE                                                                  
   64 NTQ3 = LI                                                                 
      NRANK = NOQR(2) + NTQ3                                                    
