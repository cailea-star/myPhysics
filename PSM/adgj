        CALL LARGE(MD2,NMD,NL,CC1(1,1,MIX),CC2(1,1,MIX),CC(1,1,IT),+1)          
      ELSE                                                                      
        CALL LARGE(MD2,NMD,NL,CB1(1,1,MIX),CB2(1,1,MIX),BB(1,1,IT), 0)          
        CALL LARGE(MD2,NMD,NL,CC1(1,1,MIX),CC2(1,1,MIX),CC(1,1,IT),-1)          
      ENDIF                                                                     
   10 CONTINUE                                                                  
