      SUBROUTINE ORD2QP(IT)                                                     
C                                                                               
      INCLUDE 'OE_PARA'                                                         
      PARAMETER (MD2=2*NMD)                                                     
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      COMMON /TQB1  / NOQ(2),NOQR(2),IOQ(2,MD2),IOQR(2,MD2),                    
     1                NTQ(3),NTQH(2)                                            
      COMMON /TQBM  / KTQM(2,NNRANK),ETQM(2,NNRANK),ITQM(2,NNRANK,3)            
C                                                                               
      INI=1                                                                     
      IFI=NTQH(IT)                                                              
      DO 4 M=1,2                                                                
      DO 3 I=INI,IFI                                                            
      L=I                                                                       
      E=ETQM(IT,L)                                                              
      DO 1 J=I,IFI                                                              
      IF (ETQM(IT,J).GE.E) GOTO 1                                               
      L=J                                                                       
      E=ETQM(IT,L)                                                              
    1 CONTINUE                                                                  
      IF (L.EQ.I) GOTO 3                                                        
      ETQM(IT,L)=ETQM(IT,I)                                                     
      ETQM(IT,I)=E                                                              
      K=KTQM(IT,L)                                                              
      KTQM(IT,L)=KTQM(IT,I)                                                     
      KTQM(IT,I)=K                                                              
      DO 2 N=1,3                                                                
      K=ITQM(IT,L,N)                                                            
      ITQM(IT,L,N)=ITQM(IT,I,N)                                                 
      ITQM(IT,I,N)=K                                                            
    2 CONTINUE                                                                  
    3 CONTINUE                                                                  
      INI=NTQH(IT)+1                                                            
      IFI=NTQ(IT)                                                               
    4 CONTINUE                                                                  
      END                                                                       
