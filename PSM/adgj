   23 DO 476 I=1,NL                                                             
      DO 476 J=1,NL                                                             
      T11PMU(I,J+NL,-1,MIX)=T11PMU(I+NL,J,1,MIX)                                
  476 T11PMU(I+NL,J,-1,MIX)=T11PMU(I,J+NL,1,MIX)                                
