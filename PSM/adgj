      G1(I,J)=U(I,MIX)*QEL(I,J,4,MIX)                                           
  377 G2(I,J)=V(I,MIX)*QEL(I,J,4,MIX)                                           
      DO 378 I=1,NL                                                             
      DO 378 J=1,NL                                                             
      T11PMU(I+NL,J,1,MIX)=G2(I,J)*U(J,MIX)                                     
      T20PMU(I+NL,J+NL,1,MIX)=-G2(I,J)*V(J,MIX)                                 
  378 T02PMU(I,J,1,MIX)=G1(I,J)*U(J,MIX)                                        
