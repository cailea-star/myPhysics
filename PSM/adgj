      IV(-I)=IV(I)                                                              
      X=I                                                                       
      SQ(I)=SQRT(X)                                                             
   10 CONTINUE                                                                  
      G(1)=0                                                                    
      G(2)=0                                                                    
      DO 20 I=3,IE                                                              
      X=I-1                                                                     
   20 G(I)=G(I-1)+DLOG(X)                                                       
C                                                                               
      END                                                                       
