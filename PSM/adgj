      T20PMU(I,J,-1,MIX)=-T20PMU(I+NL,J+NL,1,MIX)                               
  477 T20PMU(I+NL,J+NL,-1,MIX)=-T20PMU(I,J,1,MIX)                               
C                                                                               
      DO 478 I=1,NL                                                             
      DO 478 J=1,NL                                                             
      T02PMU(I,J,-1,MIX)=-T02PMU(I+NL,J+NL,1,MIX)                               
  478 T02PMU(I+NL,J+NL,-1,MIX)=-T02PMU(I,J,1,MIX)                               
