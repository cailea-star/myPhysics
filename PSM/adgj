   58 CONTINUE                                                                  
      IF (NTQ3.EQ.0) GOTO 60                                                    
      WRITE(1,*) ' BAND  I1   I2    T     KQP    EQP : 2NX1P STATES'            
      DO 59 I=1,NTQ3                                                            
      II=II+1                                                                   
      KT=KTQ3(I)                                                                
      ET=AETQ3(I)                                                               
      AKTQ3(II)=KT/2.                                                           
      ETQ3(II)=ET                                                               
