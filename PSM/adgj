      SUBROUTINE ORD2QP                                                         
C                                                                               
      INCLUDE 'OO_PARA'                                                         
      PARAMETER (MD2=2*NMD)                                                     
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      COMMON /TQB1  / NOQ(2),NOQR(2),IOQ(2,MD2),IOQR(2,MD2),                    
     1                NTQ,NTQH                                                  
      COMMON /TQBM  / ETQM(NNRANK),KTQM(NNRANK),ITQM(NNRANK,3)                  
C                                                                               
      INI=1                                                                     
      IFI=NTQH                                                                  
      DO 4 M=1,2                                                                
      DO 3 I=INI,IFI                                                            
      L=I                                                                       
      E=ETQM(L)                                                                 
      DO 1 J=I,IFI                                                              
      IF (ETQM(J).GE.E) GOTO 1                                                  
      L=J                                                                       
      E=ETQM(L)                                                                 
    1 CONTINUE                                                                  
      IF (L.EQ.I) GOTO 3                                                        
      ETQM(L)=ETQM(I)                                                           
      ETQM(I)=E                                                                 
      K=KTQM(L)                                                                 
      KTQM(L)=KTQM(I)                                                           
      KTQM(I)=K                                                                 
      DO 2 N=1,3                                                                
      K=ITQM(L,N)                                                               
      ITQM(L,N)=ITQM(I,N)                                                       
      ITQM(I,N)=K                                                               
    2 CONTINUE                                                                  
    3 CONTINUE                                                                  
      INI=NTQH+1                                                                
      IFI=NTQ                                                                   
    4 CONTINUE                                                                  
      END                                                                       
