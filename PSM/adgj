      IF (NTQ3.GT.NNTQ3) THEN                                                   
        WRITE(*,*) ' SET NNTQ3 IN EO_PARA FILE TO',NTQ3                         
        STOP                                                                    
      ENDIF                                                                     
C                                                                               
        IF (NRANK.EQ.0) THEN                                                    
         WRITE(*,100)                                                           
         WRITE(1,100)                                                           
  100    FORMAT(' STOP: CONFIG. SPACE EMPTY')                                   
         STOP                                                                   
        ENDIF                                                                   
C                                                                               
      IF (NRANK.GT.NNRANT) THEN                                                 
        WRITE(*,*) ' SET NNRANT IN EO_PARA FILE TO',NRANK                       
        STOP                                                                    
      ENDIF                                                                     
C                                                                               
      WRITE(1,108)                                                              
      WRITE(1,109) NRANK,NOQR(2),NTQ3                                           
      WRITE(1,*)                                                                
      WRITE(1,*) ' ----------   THE QP BASE CHOSEN:   ----------'               
      WRITE(1,*)                                                                
      II=0                                                                      
      WRITE(1,*) ' BAND  I1   I2    T     KQP    EQP : 1P STATES'               
      DO 58 I=1,NOQR(2)                                                         
