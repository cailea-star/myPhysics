C                                                                               
      SUBROUTINE INNER1                                                         
C                                                                               
C**************************************************************                 
C     IT: 1 -- NEUTRON ;      2 -- PROTON                     *                 
C     II: 1 -- P ; 2 -- Q0 ; 3 -- Q1 ; 4 -- Q2 ;              *                 
C                  5 -- P0 ; 6 -- P1 ; 7 -- P2                *                 
C     IS: 1 -- T11B  ; 2 -- T11C  ; 3 -- BT20B ; 4 -- BT20C;  *                 
C         5 -- CT20C ; 6 -- BT02B ; 7 -- BT02C ; 8 -- CT02C   *                 
C**************************************************************                 
C                                                                               
      INCLUDE 'OO_PARA'                                                         
      PARAMETER (MD2=2*NMD)                                                     
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      COMMON /CONFIG/ MXSH(2),NPSH(3,2),NILS(3,2)                               
      COMMON /INTRUD/ ITINT(2),NNINT(2),MIXINT(2),NLINT(2)                      
      COMMON /PARAM / AG(2),AGQ(2),DELE,HOLNG2(2),QCL,HFB,                      
     1                AX(3),AXH(3),XQQ(2),GQP(2)                                
      COMMON /TQB1  / NOQ(2),NOQR(2),IOQ(2,MD2),IOQR(2,MD2),                    
     1                NTQ,NTQH                                                  
      COMMON /TQB2  / ETQ(NNRANT),KTQ(NNRANT),ITQ(NNRANT,3),NRANK               
      COMMON /TQB3  / IOQB(2,MD2),ITQB(2,NNATA,2),NATA(2)                       
      COMMON /TPQAS / T11PQ(MD2,MD2,6),T20PQ(MD2,MD2,6),                        
     1                T02PQ(MD2,MD2,6)                                          
      COMMON /TQQAS / T11QQ(MD2,MD2,-2:2,6),T20QQ(MD2,MD2,-2:2,6),              
     1                T02QQ(MD2,MD2,-2:2,6)                                     
      COMMON /TPMQA / T11PMU(MD2,MD2,-2:2,6),T20PMU(MD2,MD2,-2:2,6),            
     1                T02PMU(MD2,MD2,-2:2,6)                                    
      COMMON /THQAS / T11HQ(MD2,MD2,6),T20HQ(MD2,MD2,6),                        
     1                T02HQ(MD2,MD2,6)                                          
      COMMON /TINQAS/ BB(MD2,MD2,2),CC(MD2,MD2,2)                               
      COMMON /TRACE1/ ST02B(2,12),ST20B(2,12),                                  
     1                AAT1(NNRANK,12,2),AAT2(NNRANK,12,2),                      
     2                T1AA(NNRANK,12,2),T2AA(NNRANK,12,2)                       
      COMMON /TRACE2/ AT1A(NNATA,12,2),AT2A(NNATA,12,2)                         
C                                                                               
      DIMENSION W1(MD2,MD2),W2(MD2,MD2),W3(MD2,MD2),                            
     1          W4(MD2,MD2),W5(MD2,MD2)                                         
      DIMENSION T11(MD2,MD2),T20(MD2,MD2),T02(MD2,MD2)                          
C                                                                               
      WRITE(*,101)                                                              
  101 FORMAT(20('*'),' INNER1')                                                 
C                                                                               
      DO 92 IT=1,2                                                              
      MIX = MIXINT(IT)                                                          
      NL  = NLINT(IT)                                                           
      NL2 = NL * 2                                                              
      NOQR2 = NOQR(IT)*2                                                        
C                                                                               
C     CHOOSE THE OPERATORS ACCORDING THE NUMBER II                              
C                                                                               
      IS = 0                                                                    
      DO 91 II = 0,3                                                            
      DO 91 MU = -2,2                                                           
      IF (II.EQ.0.AND.MU.NE.0) GOTO 91                                          
      IF (II.EQ.3.AND.MU.NE.0) GOTO 91                                          
      IS = IS + 1                                                               
C                                                                               
      IF (II.EQ.0) THEN                                                         
         DO 201 I=1,NL2                                                         
         DO 201 J=1,NL2                                                         
         T11(I,J) = T11PQ(I,J,MIX)                                              
         T02(I,J) = T02PQ(I,J,MIX)                                              
         T20(I,J) = T20PQ(I,J,MIX)                                              
  201    CONTINUE                                                               
      ENDIF                                                                     
C                                                                               
      IF (II.EQ.1) THEN                                                         
         DO 202 I=1,NL2                                                         
         DO 202 J=1,NL2                                                         
         T11(I,J) = T11QQ(I,J,MU,MIX)                                           
         T02(I,J) = T02QQ(I,J,MU,MIX)                                           
         T20(I,J) = T20QQ(I,J,MU,MIX)                                           
  202    CONTINUE                                                               
      ENDIF                                                                     
C                                                                               
      IF (II.EQ.2) THEN                                                         
         DO  203 I=1,NL2                                                        
         DO  203 J=1,NL2                                                        
         T11(I,J) = T11PMU(I,J,MU,MIX)                                          
         T02(I,J) = T02PMU(I,J,MU,MIX)                                          
         T20(I,J) = T20PMU(I,J,MU,MIX)                                          
  203    CONTINUE                                                               
      ENDIF                                                                     
C                                                                               
      IF (II.EQ.3) THEN                                                         
         DO  204 I=1,NL2                                                        
         DO  204 J=1,NL2                                                        
         T11(I,J) = T11HQ(I,J,MIX)                                              
         T02(I,J) = T02HQ(I,J,MIX)                                              
         T20(I,J) = T20HQ(I,J,MIX)                                              
  204    CONTINUE                                                               
      ENDIF                                                                     
C                                                                               
      DO 11 I1=1,NOQR2                                                          
      I = IOQB(IT,I1)                                                           
      DO 11 J=1,NL2                                                             
      SUM1=0.D0                                                                 
      SUM2=0.D0                                                                 
      DO 110 K=1,NL2                                                            
      SUM1=SUM1+BB(I,K,IT)*T02(K,J)                                             
  110 SUM2=SUM2+BB(I,K,IT)*T20(K,J)                                             
      W3(I,J)=SUM1                                                              
  11  W4(I,J)=SUM2                                                              
C                                                                               
C     ( A T A+ )                                                                
C                                                                               
      DO 20 I1=1,NOQR2                                                          
      I = IOQB(IT,I1)                                                           
      DO 20 J=1,NL2                                                             
      SUM=0.D0                                                                  
      DO 200 K=1,NL2                                                            
  200 SUM=SUM+BB(I,K,IT)*T02(J,K)                                               
  20  W5(I,J)=SUM                                                               
C                                                                               
      DO 21 I1=1,NOQR2                                                          
      J1 = IOQB(IT,I1)                                                          
      DO 21 I2=1,NOQR2                                                          
      J2 = IOQB(IT,I2)                                                          
      SUM1=0.D0                                                                 
      SUM2=0.D0                                                                 
      DO 210 K=1,NL2                                                            
      SUM1=SUM1+W3(J1,K)*CC(K,J2,IT)                                            
  210 SUM2=SUM2+W5(J1,K)*CC(K,J2,IT)                                            
      W1(J1,J2)=SUM1                                                            
  21  W2(J1,J2)=SUM2                                                            
C                                                                               
      DO 22 I1=1,NOQR2                                                          
      J1 = IOQB(IT,I1)                                                          
      DO 22 I2=1,NOQR2                                                          
      J2 = IOQB(IT,I2)                                                          
      SUM=0.D0                                                                  
      DO 220 K=1,NL2                                                            
  220 SUM=SUM+T11(J1,K)*CC(K,J2,IT)                                             
  22  W3(J1,J2)=SUM                                                             
C                                                                               
      I = 0                                                                     
      DO 5 I1 = 1,NOQR2                                                         
      J1 = IOQB(IT,I1)                                                          
      DO 5 I2 = 1,NOQR2                                                         
      J2 = IOQB(IT,I2)                                                          
      I = I + 1                                                                 
      AT1A(I,IS,IT)=W3(J2,J1)+0.5D0*(W2(J2,J1)-W1(J2,J1))                       
    5 CONTINUE                                                                  
C                                                                               
      IF (II.EQ.3) GOTO 113                                                     
C                                                                               
C     ( A T+ A+ )                                                               
C                                                                               
      DO 25 I1=1,NOQR2                                                          
      I = IOQB(IT,I1)                                                           
      DO 25 J=1,NL2                                                             
      SUM=0.D0                                                                  
      DO 250 K=1,NL2                                                            
  250 SUM=SUM+BB(I,K,IT)*T20(J,K)                                               
  25  W5(I,J)=SUM                                                               
C                                                                               
      DO 26 I1=1,NOQR2                                                          
      J1 = IOQB(IT,I1)                                                          
      DO 26 I2=1,NOQR2                                                          
      J2 = IOQB(IT,I2)                                                          
      SUM1=0.D0                                                                 
      SUM2=0.D0                                                                 
      SUM3=0.D0                                                                 
      DO 260 K=1,NL2                                                            
      SUM1=SUM1+T11(K,J1)*CC(K,J2,IT)                                           
      SUM2=SUM2+W5(J1,K)*CC(K,J2,IT)                                            
  260 SUM3=SUM3+W4(J1,K)*CC(K,J2,IT)                                            
      W1(J1,J2)=SUM1                                                            
      W2(J1,J2)=SUM2                                                            
  26  W3(J1,J2)=SUM3                                                            
C                                                                               
      I = 0                                                                     
      DO 6 I1 = 1,NOQR2                                                         
      J1 = IOQB(IT,I1)                                                          
      DO 6 I2 = 1,NOQR2                                                         
      J2 = IOQB(IT,I2)                                                          
      I = I + 1                                                                 
      AT2A(I,IS,IT)=W1(J2,J1)+0.5D0*(W2(J2,J1)-W3(J2,J1))                       
    6 CONTINUE                                                                  
C                                                                               
  113 CONTINUE                                                                  
   91 CONTINUE                                                                  
   92 CONTINUE                                                                  
C                                                                               
      END                                                                       
C                                                                               
C                                                                               
      SUBROUTINE INNER2                                                         
C                                                                               
C**************************************************************                 
C     IT: 1 -- NEUTRON ;      2 -- PROTON                     *                 
C     II: 1 -- P ; 2 -- Q0 ; 3 -- Q1 ; 4 -- Q2 ;              *                 
C                  5 -- P0 ; 6 -- P1 ; 7 -- P2                *                 
C     IS: 1 -- T11B  ; 2 -- T11C  ; 3 -- BT20B ; 4 -- BT20C;  *                 
C         5 -- CT20C ; 6 -- BT02B ; 7 -- BT02C ; 8 -- CT02C   *                 
C**************************************************************                 
C                                                                               
      INCLUDE 'OO_PARA'                                                         
      PARAMETER (MD2=2*NMD)                                                     
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      COMMON /BCSBCS/ ANP(2),ALAMB(2),DELTA(2),EP(NNBCS,2),                     
     1                HSP(2),QQ0(2),HH0(2),QP0(2),LNP(2)                        
      COMMON /HMILTN/ HM1(NNRANK,4),HM2(NNRANK,NNRANK,6),HM3(NNATA,2),          
     1                HM4(NNATA,NNRANK,2),HM5(NNRANK,NNATA,2),                  
     2                HM6(NNATA,NNATA)                                          
      COMMON /PARAM / AG(2),AGQ(2),DELE,HOLNG2(2),QCL,HFB,                      
     1                AX(3),AXH(3),XQQ(2),GQP(2)                                
      COMMON /TQB1  / NOQ(2),NOQR(2),IOQ(2,MD2),IOQR(2,MD2),                    
     1                NTQ,NTQH                                                  
      COMMON /TQB2  / ETQ(NNRANT),KTQ(NNRANT),ITQ(NNRANT,3),NRANK               
      COMMON /TQB3  / IOQB(2,MD2),ITQB(2,NNATA,2),NATA(2)                       
      COMMON /TRACE1/ ST02B(2,12),ST20B(2,12),                                  
     1                AAT1(NNRANK,12,2),AAT2(NNRANK,12,2),                      
     2                T1AA(NNRANK,12,2),T2AA(NNRANK,12,2)                       
      COMMON /TRACE2/ AT1A(NNATA,12,2),AT2A(NNATA,12,2)                         
C                                                                               
      WRITE(*,100)                                                              
  100 FORMAT(20('*'),' INNER2')                                                 
C                                                                               
C     ( AP AN H AN AP )                                                         
C                                                                               
      DO 19 I1 = 1,NATA(1)                                                      
      DO 19 I2 = 1,NATA(2)                                                      
      SUM = 0.D0                                                                
      DO 29 MU = -2,+2                                                          
      IS = MU+4                                                                 
   29 SUM=SUM+AT2A(I1,IS,1)*AT1A(I2,IS,2)+AT2A(I2,IS,2)*AT1A(I1,IS,1)           
      HM6(I1,I2)=-.5*AX(3)*SUM                                                  
   19 CONTINUE                                                                  
C                                                                               
C     ( AN H AN ), ( AP H AP )                                                  
C                                                                               
      DO 36 IT = 1,2                                                            
      AXX = XQQ(IT)                                                             
      DO 35 I1 = 1,NATA(IT)                                                     
      DO 45 II = 0,2                                                            
      HMSS = 0.D0                                                               
      DO 55 MU = -2,+2                                                          
      IF (II.EQ.0.AND.MU.NE.0) GOTO 55                                          
      IS = MU+4+(II-1)*5                                                        
      IF (II.EQ.0) IS = 1                                                       
      IF (II.EQ.1) THEN                                                         
        HMSS=HMSS+AX(IT)*                                                       
     +  (ST20B(IT,IS)*AT1A(I1,IS,IT)+ST02B(IT,IS)*AT2A(I1,IS,IT))               
     +           +AX(3)*                                                        
     +  (ST02B(3-IT,IS)*AT2A(I1,IS,IT)+ST20B(3-IT,IS)*AT1A(I1,IS,IT))           
      ELSE                                                                      
        HMSS=HMSS+                                                              
     +       ST20B(IT,IS)*AT1A(I1,IS,IT)+ST02B(IT,IS)*AT2A(I1,IS,IT)            
      ENDIF                                                                     
   55 CONTINUE                                                                  
      IF (II.EQ.0) HMSS0 = -AG(IT)*HMSS                                         
      IF (II.EQ.1) HMSS1 = -.5*HMSS                                             
      IF (II.EQ.2) HMSS2 = -AGQ(IT)*HMSS                                        
   45 CONTINUE                                                                  
      HM3(I1,IT)=-AGQ(IT)*QP0(IT)*(AT2A(I1,9,IT)+AT1A(I1,9,IT))                 
     +           +AT1A(I1,12,IT)-AXX*AT1A(I1,4,IT)                              
     +           -DELTA(IT)*(AT2A(I1,1,IT)+AT1A(I1,1,IT))                       
      HM3(I1,IT)=HM3(I1,IT)+HMSS0+HMSS1+HMSS2                                   
   35 CONTINUE                                                                  
   36 CONTINUE                                                                  
C                                                                               
      END                                                                       
C                                                                               
C                                                                               
      SUBROUTINE ELEM11(IBET,JBET,HR00)                                         
C                                                                               
      INCLUDE 'OO_PARA'                                                         
      PARAMETER (NNDEH=NNDEG/2)                                                 
      PARAMETER (MD2=2*NMD)                                                     
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      COMMON /HMILTN/ HM1(NNRANK,4),HM2(NNRANK,NNRANK,6),HM3(NNATA,2),          
     1                HM4(NNATA,NNRANK,2),HM5(NNRANK,NNATA,2),                  
     2                HM6(NNATA,NNATA)                                          
      COMMON /INTRUD/ ITINT(2),NNINT(2),MIXINT(2),NLINT(2)                      
      COMMON /NORHAM/ WK1(NNRANT,NNRANT,2,NNDEH),                               
     1                WK2(NNRANT,NNRANT,2,NNDEH)                                
      COMMON /TQB1  / NOQ(2),NOQR(2),IOQ(2,MD2),IOQR(2,MD2),                    
     1                NTQ,NTQH                                                  
      COMMON /TQB2  / ETQ(NNRANT),KTQ(NNRANT),ITQ(NNRANT,3),NRANK               
      COMMON /TQB3  / IOQB(2,MD2),ITQB(2,NNATA,2),NATA(2)                       
      COMMON /TINQAS/ BB(MD2,MD2,2),CC(MD2,MD2,2)                               
C                                                                               
      WRITE(*,100)                                                              
  100 FORMAT(20('*'),' ELEM11')                                                 
C                                                                               
C     < AP AN H AN AP >                                                         
C                                                                               
      DO 70 IL = 1,NTQ                                                          
      DO 70 IR = 1,NTQ                                                          
      JNL=ITQ(IL,1)                                                             
      JPL=ITQ(IL,2)                                                             
      JNR=ITQ(IR,1)                                                             
      JPR=ITQ(IR,2)                                                             
C                                                                               
      SUM = 0.D0                                                                
      ANORM=CC(JNL,JNR,1)*CC(JPL,JPR,2)                                         
      DO 1 IT = 1,2                                                             
      NOQR2 = NOQR(IT)*2                                                        
      N12 = 0                                                                   
      DO 2 N1 = 1,NOQR2                                                         
      DO 2 N2 = 1,NOQR2                                                         
      N12 = N12 + 1                                                             
      IF (IOQB(IT,N1).EQ.ITQ(IR,IT).AND.IOQB(IT,N2).EQ.ITQ(IL,IT))              
     +   GOTO 3                                                                 
    2 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM11 2'                                    
      WRITE(*,*) ' STOP: FEHLER IN ELEM11 2'                                    
      STOP                                                                      
    3 CONTINUE                                                                  
      IF (IT.EQ.1) THEN                                                         
        SUM=SUM+CC(JPL,JPR,2)*HM3(N12,1)                                        
      ELSE                                                                      
        SUM=SUM+CC(JNL,JNR,1)*HM3(N12,2)                                        
      ENDIF                                                                     
    1 CONTINUE                                                                  
C                                                                               
      NOQR1 = NOQR(1)*2                                                         
      NOQR2 = NOQR(2)*2                                                         
      N12 = 0                                                                   
      DO 13 N1 = 1,NOQR1                                                        
      DO 13 N2 = 1,NOQR1                                                        
      N12 = N12 + 1                                                             
      IF (IOQB(1,N1).EQ.JNL.AND.IOQB(1,N2).EQ.JNR) GOTO 14                      
   13 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM11 13'                                   
      STOP                                                                      
   14 CONTINUE                                                                  
      N34 = 0                                                                   
      DO 15 N1 = 1,NOQR2                                                        
      DO 15 N2 = 1,NOQR2                                                        
      N34 = N34 + 1                                                             
      IF (IOQB(2,N1).EQ.JPL.AND.IOQB(2,N2).EQ.JPR) GOTO 16                      
   15 CONTINUE                                                                  
      WRITE(1,*) ' STOP: FEHLER IN ELEM11 15'                                   
      STOP                                                                      
   16 CONTINUE                                                                  
      SUM=SUM+HM6(N12,N34)                                                      
C                                                                               
      WK1(IL,IR,JBET,IBET) = ANORM                                              
      WK2(IL,IR,JBET,IBET) = HR00*ANORM + SUM                                   
   70 CONTINUE                                                                  
C                                                                               
      END                                                                       
C                                                                               
C                                                                               
      SUBROUTINE BASE11                                                         
C                                                                               
C************************************************************                   
C        QUANTUM NUMBERS OF TWO-QUASIPARTICLE STATES        *                   
C     ITQ(IL,1)    INDEX OF A 2-NEUTRON STATE 'IL'          *                   
C     ITQ(IL,2)    INDEX OF A 2-PROTON  STATE 'IL'          *                   
C     ITQ(IL,3)    1/2 FOR K1 +/- K2; 0 FOR PAIRED 2-QP     *                   
C     KTQ(IL)      K-QUANTUM-NUMBER   K1 +/- K2             *                   
C     ETQ(IL)      QUASIPARTICLE-ENERGY E1 + E2             *                   
C************************************************************                   
C                                                                               
      INCLUDE 'OO_PARA'                                                         
      PARAMETER (MD2=2*NMD)                                                     
C                                                                               
      IMPLICIT REAL*8 (A-H,O-Z)                                                 
C                                                                               
      COMMON /CONFIG/ MXSH(2),NPSH(3,2),NILS(3,2)                               
      COMMON /INTRUD/ ITINT(2),NNINT(2),MIXINT(2),NLINT(2)                      
      COMMON /MAXMAX/ EMAX(3),KMAX(3),NMAX(3),JMAX                              
      COMMON /TQB1  / NOQ(2),NOQR(2),IOQ(2,MD2),IOQR(2,MD2),                    
     1                NTQ,NTQH                                                  
      COMMON /TQB2  / ETQ(NNRANT),KTQ(NNRANT),ITQ(NNRANT,3),NRANK               
      COMMON /TQB3  / IOQB(2,MD2),ITQB(2,NNATA,2),NATA(2)                       
      COMMON /TQBM  / ETQM(NNRANK),KTQM(NNRANK),ITQM(NNRANK,3)                  
      COMMON /UVUV  / ESP(NMD,6),EQP(NMD,6),U(NMD,6),V(NMD,6),                  
     1                KQN(NMD,6)                                                
C                                                                               
      DIMENSION MI(2),MF(2)                                                     
C                                                                               
      CHARACTER*15 TITLE                                                        
C                                                                               
      NP=0                                                                      
      MP=0                                                                      
      DO 15 J=1,2                                                               
      MS=MXSH(J)                                                                
      DO 15 I=1,MS                                                              
      MP=MP+1                                                                   
   15 IF (NILS(I,J).GT.NP) NP=NILS(I,J)                                         
C                                                                               
      WRITE(1,*)                                                                
      WRITE(1,*) ' SINGLE-PARTICLE BASIS'                                       
      WRITE(1,*) ' ~~~~~~~~~~~~~~~~~~~~~'                                       
      WRITE(1,*)                                                                
C                                                                               
      TITLE='NILSSON LEVELS:'                                                   
      WRITE(1,115) TITLE,MXSH,((NPSH(I,J),I=1,MXSH(J)),J=1,2)                   
      DO 16 I=1,NP                                                              
   16 WRITE(1,116) I,(KQN(I,J),ESP(I,J),J=1,MP)                                 
      WRITE(1,*)                                                                
      WRITE(1,*)                                                                
      TITLE='QUASIPARTICLES:'                                                   
      WRITE(1,115) TITLE,MXSH,((NPSH(I,J),I=1,MXSH(J)),J=1,2)                   
      DO 17 I=1,NP                                                              
   17 WRITE(1,116) I,(KQN(I,J),EQP(I,J),J=1,MP)                                 
      WRITE(1,*)                                                                
C                                                                               
      WRITE(1,*)                                                                
      WRITE(1,*) ' MULTI-QUASIPARTICLE BASIS'                                   
      WRITE(1,*) ' ~~~~~~~~~~~~~~~~~~~~~~~~~'                                   
C                                                                               
      DO 3 IT=1,2                                                               
      I=0                                                                       
      DO 1 I1=1,NLINT(IT)                                                       
      I=I+1                                                                     
      IOQ(IT,I)=I1                                                              
    1 IOQR(IT,I1)=I                                                             
      NOQ(IT)=I                                                                 
    3 CONTINUE                                                                  
C------------------------------                                                 
C     CHOICE OF THE PAIRS                                                       
C------------------------------                                                 
      DO 51 IT=1,2                                                              
      LOW=1                                                                     
      ELOW=EQP(1,MIXINT(IT))                                                    
      DO 50 I=1,NLINT(IT)                                                       
      IF (EQP(I,MIXINT(IT)).GE.ELOW) GOTO 50                                    
      LOW=I                                                                     
      ELOW=EQP(I,MIXINT(IT))                                                    
   50 CONTINUE                                                                  
      NH=NMAX(IT)                                                               
      MI(IT)=MAX(1,LOW-NH/2)                                                    
      MF(IT)=MIN(NLINT(IT),MI(IT)+NH-1)                                         
      IF (MI(IT).EQ.1) MF(IT)=MI(IT)+NH-1                                       
      IF (MF(IT).EQ.NLINT(IT)) MI(IT)=MF(IT)-NH+1                               
   51 CONTINUE                                                                  
      NH=NMAX(3)/2                                                              
C                                                                               
      IL = 0                                                                    
      DO 7 I1=MI(1),MF(1)                                                       
      IF (EQP(I1,MIXINT(1)).GT.EMAX(1)) GOTO 7                                  
      IF (IABS(KQN(I1,MIXINT(1))).GT.KMAX(1)) GOTO 7                            
      DO 8 I2=MI(2),MF(2)                                                       
      IF (IL.GE.NH) GOTO 9                                                      
      IF (EQP(I2,MIXINT(2)).GT.EMAX(2)) GOTO 8                                  
      IF (IABS(KQN(I2,MIXINT(2))).GT.KMAX(2)) GOTO 8                            
      ECHK = EQP(I1,MIXINT(1))+EQP(I2,MIXINT(2))                                
      KCHK = (KQN(I1,MIXINT(1))+KQN(I2,MIXINT(2)))/2                            
      IF (ECHK.GT.EMAX(3)) GOTO 8                                               
      IF (IABS(KCHK).GT.KMAX(3)) GOTO 8                                         
      IL = IL + 1                                                               
      ITQM(IL,1)=I1                                                             
      ITQM(IL,2)=I2                                                             
      ITQM(IL,3)=1                                                              
      KTQM(IL)=KCHK                                                             
      ETQM(IL)=ECHK                                                             
    8 CONTINUE                                                                  
    7 CONTINUE                                                                  
    9 NTQH = IL                                                                 
C                                                                               
      DO 11 I1=MI(1),MF(1)                                                      
      IF (EQP(I1,MIXINT(1)).GT.EMAX(1)) GOTO 11                                 
      IF (IABS(KQN(I1,MIXINT(1))).GT.KMAX(1)) GOTO 11                           
      DO 12 I2=MI(2),MF(2)                                                      
      IF (IL.GE.NMAX(3)) GOTO 13                                                
      IF (EQP(I2,MIXINT(2)).GT.EMAX(2)) GOTO 12                                 
      IF (IABS(KQN(I2,MIXINT(2))).GT.KMAX(2)) GOTO 12                           
      ECHK = EQP(I1,MIXINT(1))+EQP(I2,MIXINT(2))                                
      KCHK = (KQN(I1,MIXINT(1))-KQN(I2,MIXINT(2)))/2                            
      IF (ECHK.GT.EMAX(3)) GOTO 12                                              
      IF (IABS(KCHK).GT.KMAX(3)) GOTO 12                                        
      IL = IL + 1                                                               
      ITQM(IL,1)=I1                                                             
      ITQM(IL,2)=I2                                                             
      ITQM(IL,3)=2                                                              
      KTQM(IL)=KCHK                                                             
      ETQM(IL)=ECHK                                                             
   12 CONTINUE                                                                  
   11 CONTINUE                                                                  
   13 NTQ = IL                                                                  
C                                                                               
      CALL ORD2QP                                                               
C                                                                               
C-----------------------------------------------------                          
C     FIND THE RELEVANT SINGLE PARTICLE STATES                                  
C-----------------------------------------------------                          
C                                                                               
      DO 6 IT = 1,2                                                             
      IF (IT.EQ.1) THEN                                                         
        WRITE(1,111)                                                            
        WRITE(1,101) KMAX(IT),EMAX(IT),NMAX(IT)                                 
      ELSE                                                                      
        WRITE(1,112)                                                            
        WRITE(1,102) KMAX(IT),EMAX(IT),NMAX(IT)                                 
      ENDIF                                                                     
      WRITE(1,110) MIXINT(IT),NNINT(IT),NLINT(IT)                               
      II=0                                                                      
      DO 20 I1=1,NOQ(IT)                                                        
      DO 21 I2=1,NTQ                                                            
      IF (IOQ(IT,I1).EQ.ITQM(I2,IT)) THEN                                       
        II=II+1                                                                 
        IOQ(IT,II)=IOQ(IT,I1)                                                   
        IOQR(IT,IOQ(IT,II))=II                                                  
        GOTO 20                                                                 
      ENDIF                                                                     
   21 CONTINUE                                                                  
   20 CONTINUE                                                                  
      NOQR(IT)=II                                                               
C                                                                               
      NOQR2=II*2                                                                
      NATA(IT)=NOQR2*NOQR2                                                      
      IF (NATA(IT).GT.NNATA) THEN                                               
        WRITE(*,*) 'SET NNATA IN OO_PARA FILE TO',NATA(IT)                      
        STOP                                                                    
      ENDIF                                                                     
C                                                                               
      N12 = 0                                                                   
      DO 27 I1= 1,NOQR2                                                         
      DO 27 I2= 1,NOQR2                                                         
      N12 = N12 + 1                                                             
      ITQB(IT,N12,1)=I1                                                         
   27 ITQB(IT,N12,2)=I2                                                         
      NATA(IT) = N12                                                            
      DO 28 I=1,NOQR(IT)                                                        
      IOQB(IT,I)=IOQ(IT,I)                                                      
   28 IOQB(IT,I+NOQR(IT))=IOQ(IT,I)+NLINT(IT)                                   
C                                                                               
C---------------------                                                          
C     PRINT OUT                                                                 
C---------------------                                                          
C                                                                               
      WRITE(1,104) NOQR(IT)                                                     
      DO 30 I1=1,NOQR(IT)                                                       
      II1=IOQ(IT,I1)                                                            
      UMV=U(II1,MIXINT(IT))**2-V(II1,MIXINT(IT))**2                             
      UV=U(II1,MIXINT(IT))*V(II1,MIXINT(IT))                                    
   30 WRITE(1,105) I1,IOQ(IT,I1),KQN(IOQ(IT,I1),MIXINT(IT)),                    
     1      EQP(IOQ(IT,I1),MIXINT(IT)),UMV,UV,                                  
     2      U(II1,MIXINT(IT)),V(II1,MIXINT(IT))                                 
C                                                                               
    6 CONTINUE                                                                  
C                                                                               
      IIN=NTQH+1                                                                
      DO 24 II = IIN,NTQ                                                        
   24 ITQM(II,2) = ITQM(II,2) + NLINT(2)                                        
C                                                                               
      WRITE(1,106) NTQ,NTQH                                                     
      DO 31 II = 1,NTQ                                                          
      I1 = ITQM(II,1)                                                           
      IF (II.LE.NTQH) THEN                                                      
        I2 = ITQM(II,2)                                                         
      ELSE                                                                      
        I2 = ITQM(II,2)-NLINT(2)                                                
      ENDIF                                                                     
C                                                                               
      UMV = U(I1,MIXINT(1))**2 - V(I1,MIXINT(1))**2                             
     1    + U(I2,MIXINT(2))**2 - V(I2,MIXINT(2))**2                             
      UV  = U(I1,MIXINT(1))*V(I1,MIXINT(1))                                     
     1     +U(I2,MIXINT(2))*V(I2,MIXINT(2))                                     
   31 WRITE(1,107) II,(ITQM(II,J),J=1,3),KTQM(II),ETQM(II),UMV,UV               
C---------------------------                                                    
C       REARANGEMENT                                                            
C---------------------------                                                    
      DO 4 I =1,NTQ                                                             
      KTQ(I) = KTQM(I)                                                          
      ETQ(I) = ETQM(I)                                                          
      DO 5 J=1,3                                                                
    5 ITQ(I,J) = ITQM(I,J)                                                      
    4 CONTINUE                                                                  
      NRANK = NTQ                                                               
C                                                                               
      IF (NRANK.EQ.0) THEN                                                      
        WRITE(*,100)                                                            
        WRITE(1,100)                                                            
  100   FORMAT(' STOP: CONFIG. SPACE EMPTY')                                    
        STOP                                                                    
      ENDIF                                                                     
C                                                                               
      IF (NRANK.GT.NNRANT) THEN                                                 
        WRITE(*,*) 'SET NNRANT IN OO_PARA FILE TO',NRANK                        
        STOP                                                                    
      ENDIF                                                                     
C                                                                               
      WRITE(1,108)                                                              
      WRITE(1,109) NRANK                                                        
      WRITE(1,*)                                                                
      WRITE(1,*) ' ----------   THE QP BASE CHOSEN:   ----------'               
      WRITE(1,*)                                                                
      WRITE(1,*) ' BAND  I1   I2    T   KQP   EQP : 1NX1P STATES'               
      DO 72 I=1,NRANK                                                           
      WRITE(1,114) I,(ITQ(I,N),N=1,3),KTQ(I),ETQ(I)                             
   72 CONTINUE                                                                  
C                                                                               
  101 FORMAT(/5X,'KMAX =',I3,'/2',3X,'EMAX =',F5.2,5X,'NMAX =',I3,              
     1        5X,'[1-QUASINEUTRON]')                                            
  102 FORMAT(/5X,'KMAX =',I3,'/2',3X,'EMAX =',F5.2,5X,'NMAX =',I3,              
     1        5X,'[1-QUASIPROTON]')                                             
  103 FORMAT('NTQH =',2I3,'       NTQ =',2I3,'      NOQ =',2I3)                 
  104 FORMAT(/' 1-QP BASIS:  NOQ =',I3,' LEVELS',/,30('-'),/,                   
     1     '  I',' IOQ(I)','    K',6X,'E',10X,'U**2-V**2',                      
     2     6X,'UV',10X,'U',11X,'V')                                             
  105 FORMAT(I3,I4,I7,'/2',5F12.5)                                              
  106 FORMAT(//,' NEUTRON-PROTON BASIS:   NTQ =',I3,' STATES',                  
     1  ' (NTQH = ',I3,')',/,55('-'),/,                                         
     2  ' II   I1 I2   T   K',5X,'E',10X,'U**2-V**2',6X,'UV')                   
  107 FORMAT(I3,I5,I3,2I4,3F12.5)                                               
  108 FORMAT(/)                                                                 
  109 FORMAT(' DIMENSION OF THE CONFIG. SPACE: ',I4)                            
  110 FORMAT(3X,'MIXINT =',I3,4X,'NNINT =',I3,6X,'NLINT =',I3)                  
  111 FORMAT(/,'  NEUTRON STATES :')                                            
  112 FORMAT(/,'  PROTON  STATES :')                                            
  114 FORMAT(4I5,I6,F7.3)                                                       
  115 FORMAT(1X,'NO. 2*K ENERGY OF ',A15,I2,' NEUTRON- AND',I2,                 
     1      ' PROTON-SHELLS'/1X,'--- --- ------'/4X,6(6X,'N=',I1,3X))           
  116 FORMAT(I3,6(I5,F7.3))                                                     
C                                                                               
      END                                                                       
